# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Every variable below is an OpenRouter key (https://openrouter.ai/keys), BYOK Google AI Studio for
# google/gemma-4-26b-a4b-it:free. Use a DIFFERENT account per variable so the per-account limits
# (20 requests/minute, 50 requests/day) are shared out. A role variable that is empty or missing
# falls back to OPENROUTER_API_KEY. The mapping prompt -> role is in config/settings.yaml (llm.api_key_roles).

# Default key: used by any role whose own variable is unset.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME_DEFAULT

# reframe, doc_classify, align, normalise
OPENROUTER_API_KEY_PREP=sk-or-v1-REPLACE_ME_PREP

# doc_claim, claim_check
OPENROUTER_API_KEY_CLAIMS=sk-or-v1-REPLACE_ME_CLAIMS

# persona
OPENROUTER_API_KEY_PERSONA=sk-or-v1-REPLACE_ME_PERSONA

# buyer_opening, buyer_reply, buyer_reveal, reveal_check
OPENROUTER_API_KEY_BUYER=sk-or-v1-REPLACE_ME_BUYER

# negotiator_extract, negotiator_interpret, negotiator_reply, negotiator_acknowledge, negotiator_clarify
OPENROUTER_API_KEY_NEGOTIATOR=sk-or-v1-REPLACE_ME_NEGOTIATOR
